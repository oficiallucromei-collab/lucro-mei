LUCROMEI_GROWTH_PUBLIC_URL=
LUCROMEI_GROWTH_PRIVACY_URL=
LUCROMEI_GROWTH_TERMS_URL=
LUCROMEI_GROWTH_FOUNDER_TOKEN=
LUCROMEI_GROWTH_TRIAL_HOLD_KEY=
LUCROMEI_GROWTH_TRIAL_HOLD_DAYS=180
LUCROMEI_GROWTH_TRIAL_DAYS=14
LUCROMEI_GROWTH_ACTIVATION_COUNT=3
LUCROMEI_GROWTH_ACTIVATION_HOURS=48
LUCROMEI_GROWTH_PRICE_CENTS=2490
LUCROMEI_GROWTH_BUDGET_CENTS=15000
LUCROMEI_GROWTH_BUDGET_ALERT_PERCENT=80
LUCROMEI_GROWTH_CAMPAIGN_DAYS=10
LUCROMEI_GROWTH_TARGET_ACTIVATED=5
LUCROMEI_GROWTH_TARGET_PAID=2
LUCROMEI_GROWTH_PUBLIC_REQUESTS_PER_MINUTE=240
LUCROMEI_GROWTH_STRIPE_LIVE=false
LUCROMEI_GROWTH_STRIPE_KEY=
LUCROMEI_GROWTH_STRIPE_PRICE=
