LUCROMEI_ENVIRONMENT=local
LUCROMEI_DATABASE_URL=sqlite:///./lucromei.db
LUCROMEI_WHATSAPP_VERIFY_TOKEN=change-me
LUCROMEI_WHATSAPP_APP_SECRET=change-me

LUCROMEI_BUSINESS_TIMEZONE=America/Sao_Paulo
# Required to use the internal /v1 endpoints; leave empty to disable them.
LUCROMEI_INTERNAL_API_KEY=

# Background worker: "embedded" runs it inside the web process; "off" if you run
# `python -m lucromei.worker` separately. On Cloud Run, "embedded" needs CPU always allocated.
LUCROMEI_WORKER_MODE=embedded
LUCROMEI_JOB_MAX_ATTEMPTS=8
