LUCROMEI_ENVIRONMENT=local
LUCROMEI_DATABASE_URL=sqlite:///./lucromei.db
LUCROMEI_WHATSAPP_VERIFY_TOKEN=change-me
LUCROMEI_WHATSAPP_APP_SECRET=change-me
# Cloud API credentials (Meta app dashboard > WhatsApp > API setup). Leave empty locally to
# record replies with the mock sender; production refuses to start without them.
LUCROMEI_WHATSAPP_ACCESS_TOKEN=
LUCROMEI_WHATSAPP_PHONE_NUMBER_ID=
LUCROMEI_WHATSAPP_GRAPH_API_VERSION=v25.0

LUCROMEI_BUSINESS_TIMEZONE=America/Sao_Paulo
# Required to use the internal /v1 endpoints; leave empty to disable them.
LUCROMEI_INTERNAL_API_KEY=

# Background worker: "embedded" runs it inside the web process; "off" if you run
# `python -m lucromei.worker` separately. On Cloud Run, "embedded" needs CPU always allocated.
LUCROMEI_WORKER_MODE=embedded
LUCROMEI_JOB_MAX_ATTEMPTS=8

# Onboarding: terms shown on first contact (required in production) and free-trial length.
LUCROMEI_TERMS_VERSION=2026-11-20
LUCROMEI_TERMS_URL=
LUCROMEI_TRIAL_DAYS=14
# Hours before an unanswered "despesa ou retirada?" question expires.
LUCROMEI_PENDING_ENTRY_TTL_HOURS=24

# AI fallback (Anthropic API) for messages the rules cannot read. Off while empty. The AI only
# suggests: every suggestion is validated and confirmed by the user before it is recorded.
LUCROMEI_AI_API_KEY=
LUCROMEI_AI_MODEL=claude-haiku-5-5
LUCROMEI_AI_DAILY_CALLS_PER_BUSINESS=30
# Millionths of a US dollar per million tokens, used for the cost recorded in ai_usage.
LUCROMEI_AI_INPUT_PRICE_MICRO_USD_PER_MTOK=100000
LUCROMEI_AI_OUTPUT_PRICE_MICRO_USD_PER_MTOK=500000

# Observability: JSON logs (no message text or amounts). Sentry is off while the DSN is empty.
LUCROMEI_LOG_LEVEL=INFO
LUCROMEI_SENTRY_DSN=
LUCROMEI_SENTRY_TRACES_SAMPLE_RATE=0.0

# Privacy (LGPD): raw message text is erased after this many days; ledger entries stay while the
# account exists. Deletion requests run after a grace period. The hash key (32+ characters,
# required in production) signs the anonymous proof kept after an account is erased.
LUCROMEI_MESSAGE_TEXT_RETENTION_DAYS=90
LUCROMEI_DELETION_GRACE_DAYS=7
LUCROMEI_PRIVACY_HASH_KEY=
